{
  "name": "@volt/electron-compat",
  "version": "0.1.0",
  "description": "Drop-in electron replacement for apps running on Volt",
  "license": "Apache-2.0",
  "author": "The Volt Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/nehemiyawicks/volt.git",
    "directory": "packages/electron-compat"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
